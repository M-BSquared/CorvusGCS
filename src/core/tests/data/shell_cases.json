   "scenario": {
    "name": "raw_stream_with_backlog_and_subscribers",
    "limits": {
     "backlog": 20
    },
    "steps": [
     {
      "op": "add_sub"
     },
     {
      "op": "write",
      "text": "a"
     },
     {
      "op": "recv",
      "device": 10,
      "data": "line one\nline two\n"
     },
     {
      "op": "recv",
      "device": 10,
      "data": "line three\n"
     },
     {
      "op": "add_sub"
     },
     {
      "op": "recv",
      "device": 10,
      "data": "!"
     },
     {
      "op": "remove_sub",
      "which": 0
     },
     {
      "op": "recv",
      "device": 10,
      "data": "?"
     },
     {
      "op": "state"
     }
    ]
   },
